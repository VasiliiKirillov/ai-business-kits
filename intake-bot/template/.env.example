# Скопируй в .env и впиши значения. Файл .env не коммитить.

# --- Telegram ---
# токен бота от @BotFather
BOT_TOKEN=
# id группы менеджеров: добавь бота в группу и отправь там /id
MANAGER_CHAT_ID=

# --- Конфиг бизнеса ---
# путь к yaml (по умолчанию config/business.yaml)
BUSINESS_CONFIG=

# --- Нейросеть ---
# anthropic | openai | deepseek | openrouter | ollama | custom | mock
LLM_PROVIDER=
# модели: проверь актуальные имена у провайдера (пусто = значения по умолчанию)
LLM_MODEL_PARSE=
LLM_MODEL_CHAT=
# ключ API (только официальный ключ провайдера)
LLM_API_KEY=
# адрес API для custom и ollama
LLM_BASE_URL=
# прокси для сервера в стране, где API закрыт (http://host:port или socks5://host:port, для socks: pip install "httpx[socks]")
LLM_PROXY=
# провайдер для чтения фото документов, если отличается от основного (нужна модель с картинками)
VISION_PROVIDER=
# только anthropic: уровень рассуждений (low/medium/high, пусто = не отправлять)
ANTHROPIC_EFFORT=low

# --- Голос (необязательно) ---
# команда распознавания: STT_CMD <входной файл> <папка вывода>, должна положить transcript.txt в папку
STT_CMD=

# --- Данные ---
# путь к sqlite (по умолчанию intake.db)
DB_PATH=
# папка с фото позиций (по умолчанию photos)
PHOTOS_DIR=

# --- Google (только если data.source = google_sheets или documents.engine = google_docs) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# файл с токеном (по умолчанию google_token.json)
GOOGLE_TOKEN_FILE=
# id таблицы, печатает tools/setup_google_sheet.py
SHEET_ID=
# id шаблона документа в Google Docs
GOOGLE_DOC_TEMPLATE_ID=
# папка Drive для готовых документов (необязательно)
GOOGLE_DOCS_FOLDER_ID=
